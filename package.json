{
  "name": "@dsillman2000/yaml-reference-ts",
  "version": "1.7.1",
  "description": "A Node.js TypeScript library for resolving YAML documents containing !reference and !reference-all tags",
  "repository": {
    "type": "git",
    "url": "https://github.com/dsillman2000/yaml-reference-ts"
  },
  "homepage": "https://github.com/dsillman2000/yaml-reference-ts#readme",
  "bugs": {
    "url": "https://github.com/dsillman2000/yaml-reference-ts/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "yaml-reference-cli": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:specs": "chmod +x $PWD/dist/cli/index.js && curl -sL https://api.github.com/repos/dsillman2000/yaml-reference-specs/releases/latest | jq -r .tag_name | YAML_REFERENCE_CLI_EXECUTABLE=$PWD/dist/cli/index.js xargs -I {} go run github.com/dsillman2000/yaml-reference-specs@{}",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "check-specs": "npm run build && ./scripts/update-spec-badge.sh"
  },
  "keywords": [
    "yaml",
    "reference",
    "resolver",
    "configuration",
    "typescript"
  ],
  "author": "David Sillman <dsillman2000@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "glob": "^13.0.6",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "jest": "^30.5.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "test-exclude": "^8.0.0",
    "@jest/reporters": {
      "glob": "$glob"
    },
    "jest-config": {
      "glob": "$glob"
    },
    "jest-runtime": {
      "glob": "$glob"
    }
  },
  "files": [
    "dist",
    "README.md"
  ]
}
